mixin register()
    div(class='register-credentials-wrapper forms-wrapper')
        .forms-container
            form
                div(class='register-nick-name-container forms-field')
                    label(for='register-name-name') Name
                    input(type='text' id='register-nick-name')
                div(class='register-nick-name-container forms-field')
                    label(for='register-nick-name') Login
                    input(type='text' id='register-nick-name')
                div(class='register-passowrd-container forms-field')
                    label(for='register-password') Passowrd
                    input(type='password' id='register-password' title='Should have a letter and a digit, should be at least 5 characters long')
                div(class='register-passowrd-container forms-field')
                    label(for='register-repeat-password') Repeat passowrd
                    input(type='password' id='register-password')
                div(class='register-keypad-container')
                    div(class='register-create-account forms-button')
                        span Create account
